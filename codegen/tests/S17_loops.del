(* §2.5 Loops — combined for + while
 * `for i := 1 to 10` accumulates a sum, then a `while (i < 3)` loop
 * counts back up — exercises both shapes back-to-back over the same
 * global counter. *)
program S17_loops;

var i : integer;
var sum : integer = 0;

begin
    for i := 1 to 10 do
    begin
        sum := sum + i;
    end;
    writeln sum;

    i := 0;
    while (i < 3) do
    begin
        writeln i;
        i := i + 1;
    end;
end S17_loops.
