(* §2.6 Function Declaration and Invocation
 * function -> static method; params occupy slots 0..N-1;
 * call site uses invokestatic <ret> <class>.<name>(<types...>). *)
program S12_func;
function add(x : integer, y : integer) : integer;
begin
    return x + y;
end add;

function square(x : integer) : integer;
begin
    return x * x;
end square;

begin
    writeln add(3, 4);
    writeln square(5);
    writeln add(square(2), square(3));
end S12_func.
